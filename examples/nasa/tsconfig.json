{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"lib": ["ESNext"],
		"types": ["bun"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"allowJs": true,

		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["index.ts"]
}
