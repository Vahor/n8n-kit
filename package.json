{
	"name": "@vahor/n8n-kit-workspace",
	"version": "0.0.0",
	"workspaces": {
		"packages": [
			"packages/*",
			"examples/*"
		],
		"catalog": {
			"tsdown": "^0.21.10",
			"typescript": "^6.0.3",
			"arktype": "^2.2.0",
			"nano-spawn": "^2.1.0",
			"chalk": "^5.6.2",
			"codemaker": "^1.129.0"
		}
	},
	"overrides": {
		"isolated-vm": "file:./stubs/empty"
	},
	"description": "Build n8n workflows using code",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vahor/n8n-kit.git"
	},
	"private": true,
	"author": {
		"email": "me@vahor.fr"
	},
	"keywords": [
		"n8n",
		"builder",
		"workflow",
		"automation"
	],
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"@types/bun": "1.3.13",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"pkg-pr-new": "^0.0.70",
		"typedoc": "^0.28.19",
		"typedoc-theme-oxide": "^0.3.0",
		"isolated-vm": "file:./stubs/empty",
		"@microsoft/agents-hosting": "file:./stubs/empty",
		"@microsoft/agents-a365-observability": "file:./stubs/empty",
		"@microsoft/agents-a365-runtime": "file:./stubs/empty",
		"@microsoft/agents-a365-tooling": "file:./stubs/empty",
		"@microsoft/agents-activity": "file:./stubs/empty"
	},
	"scripts": {
		"build": "bun run --filter '*' build",
		"dev": "bun run --filter '*' dev",
		"format": "bunx @biomejs/biome check ./ --write",
		"typecheck": "bun run --filter '*' typecheck",
		"docs": "bunx typedoc",
		"docs:watch": "bunx typedoc --watch",
		"ci:version": "bunx @changesets/cli version && bun update",
		"ci:publish": "for dir in packages/*; do (cd \"$dir\" && bun run build && bun publish || true); done && changeset tag"
	},
	"engines": {
		"bun": ">=1.3.1",
		"node": ">=22.18.0"
	},
	"lint-staged": {
		"!(**/generated/**)": [
			"biome check --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	}
}
